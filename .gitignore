# ===== EDITORS AND IDE =====
.idea/
*/.idea
*/*/.idea/
*/*/.idea/*
.vs/
*/*/.vs/
.vscode/
*/*/.vscode/
.gradle/
*/*/.gradle/
/[Aa]ssets/Plugins/Editor/JetBrains*
*/*/[Aa]ssets/Plugins/Editor/JetBrains*

# ===== PYTHON =====
*.pyc
__pycache__/

# ===== PROJECT OUTPUT =====
# A run directory carries its policy checkpoints and the tree runs to gigabytes
# Metrics/ holds the metric files analysis needs and is tracked
/Results/
/Algorithms/Results/
/OutputResults/

# Unity writes trajectory recordings here while the scene is playing
/Environments/DRLNavigation/Assets/Resources/Results/

# Regenerated by run_smoke_tests.bat
smoketest.log

# Cluster downloads land in the root before being moved out of the repository
/*.zip

# ===== UNITY =====
# Taken from https://github.com/github/gitignore/blob/main/Unity.gitignore
# Each rule is paired: the first form matches the repository root, the second the Unity project at Environments/DRLNavigation/

/[Ll]ibrary/
*/*/[Ll]ibrary/
/[Tt]emp/
*/*/[Tt]emp/
/[Oo]bj/
*/*/[Oo]bj/
/[Bb]uild/
*/*/[Bb]uild/
/[Bb]uilds/
*/*/[Bb]uilds/
/[Ll]ogs/
*/*/[Ll]ogs/
/[Uu]ser[Ss]ettings/
*/*/[Uu]ser[Ss]ettings/

# Memory captures grow large and can hold sensitive data
/[Mm]emoryCaptures/
*/*/[Mm]emoryCaptures/

# Recordings grow large
/[Rr]ecordings/
*/*/[Rr]ecordings/

# Packed addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
*/*/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Auto-generated Android assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*
*/*/[Aa]ssets/[Ss]treamingAssets/aa.meta
*/*/[Aa]ssets/[Ss]treamingAssets/aa/*

# Solution and project files generated by the IDE
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Meta files for the above
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Written by Unity on a crash
sysinfo.txt

# Player builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics
crashlytics-build.properties
*/crashlytics-build.properties
